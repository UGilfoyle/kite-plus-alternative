{
  "manifest_version": 3,
  "name": "KitePlus Clone",
  "version": "1.0.0",
  "description": "Premium companion extension for Zerodha Kite. Adds custom Status Bar, Positions Grouping, Express Baskets, and real-time charges.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kite.zerodha.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
